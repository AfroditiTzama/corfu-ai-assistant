CORFU_APP_NAME=Corfu AI Tourist Assistant
CORFU_DATASET_PATH=./corfu_dataset.json
CORFU_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional local model cache. Otherwise Hugging Face's standard cache is used.
# CORFU_EMBEDDING_CACHE_DIR=./.cache/sentence-transformers
GOOGLE_API_KEY=
CORFU_GEMINI_MODEL=gemini-3.5-flash-lite
CORFU_LLM_TIMEOUT_SECONDS=30
# Synthetic weather is local development-only; keep disabled for live forecasts.
CORFU_ENVIRONMENT=development
CORFU_WEATHER_FIXTURE_ENABLED=false
CORFU_WEATHER_FIXTURE_PATH=./corfu_synthetic_rain.json
# Default point is CF-001 Old Fortress from corfu_dataset.json (Corfu Town).
CORFU_WEATHER_LATITUDE=39.6231266
CORFU_WEATHER_LONGITUDE=19.9285412
CORFU_WEATHER_TIMEZONE=Europe/Athens
CORFU_WEATHER_TIMEOUT_SECONDS=10
CORFU_WEATHER_RETRY_BUDGET=1
# JSON array of explicit browser origins. Add another exact origin for a different Vite port.
CORFU_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
